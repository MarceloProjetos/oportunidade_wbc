# Configuração SAP HANA
SAP_HOST=seu_host_sap
SAP_PORT=30015
SAP_USER=seu_usuario_sap
SAP_PASSWORD=sua_senha_sap
SAP_DATABASE=SUA_DATABASE          # opcional: deixe em branco se o HANA conectar sem databaseName
SAP_SCHEMA=SBOALTAMIRAPROD         # schema onde a view está (ex.: SBOALTAMIRAPROD)
SAP_VIEW_NAME=VW_EVOL_OPORTUNIDADE_ALT

# Configuração Supabase
SUPABASE_URL=https://seu_project.supabase.co
SUPABASE_KEY=sua_chave_anon_publica
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role   # usada na ESCRITA (ignora RLS)

# Tabela Supabase
TABLE_NAME=oportunidades
# SUPABASE_TIMEOUT_S=120           # opcional: timeout REST PostgREST em segundos (default: 120)

# Ordens de Serviço — pipeline sob demanda, por N_PED, espelhando a view HANA
# CONSOLIDADA VW_OS_INTEGRACAO (OS + estrutura/árvore + orçamento) numa ÚNICA tabela.
# (todas opcionais; têm default). Usa a MESMA conexão SAP acima.
# OS_SAP_VIEW_NAME=VW_OS_INTEGRACAO
# OS_TABLE_NAME=vw_os_integracao
# OS_SYNC_LOG_TABLE_NAME=sincronizacao_log_os_integracao
# OS_EXECUTION_MODE=replace_nped   # replace_nped (substitui o pedido) | insert (acumula)
# OS_INSERT_BATCH_SIZE=500         # lote de inserção
# --- API HTTP de disparo (api.py) ---
# OS_API_KEY=                      # chave do endpoint (RECOMENDADO em produção; vazio = sem auth)
# OS_API_HOST=0.0.0.0              # host do servidor da API
# OS_API_PORT=8077                 # porta do servidor da API

# --- Ordem de Producao: ESCRITA de status no SAP (ordens_producao_sl.py) ---
# UNICO caminho de escrita em SAP deste servico, e ele aponta para PRODUCAO.
# Nasce DESLIGADO de proposito: sem OP_SL_ENABLED=true as rotas /ordens-producao
# respondem 503 e nao abrem socket. Rollback em producao = voltar para false + restart.
# OP_SL_ENABLED=false
# OP_SL_SERVER=sapbusinessonehana-vm
# OP_SL_PORT=50000
# OP_SL_COMPANY_DB=SBOALTAMIRAPROD
# OP_SL_USERNAME=                     # OBRIGATORIO quando OP_SL_ENABLED=true
# OP_SL_PASSWORD=                     # OBRIGATORIO quando OP_SL_ENABLED=true
# OP_SL_VERIFY_SSL=false              # cert autoassinado do SL interno; true quando houver cert
# OP_SL_TIMEOUT_CONNECT_S=5           # host morto falha rapido
# OP_SL_TIMEOUT_READ_S=30             # 1a query do SL paga a carga da OBServerDLL
# OP_SL_SESSION_TTL_S=2700            # 45 min; login por request esgota o pool do SL
# OP_STATUS_PERMITIDOS=boposReleased,boposClosed   # allowlist: so Liberar e Encerrar.
#                                     # Codigo desconhecido aqui e DESCARTADO (nao vai ao SAP);
#                                     # lista vazia bloqueia TODA escrita (fail closed).
# RATE_OP_STATUS_MAX=20               # escritas de status por minuto (trava anti-loop)
# Obs.: a rota POST de status exige OS_API_KEY definida. Sem chave ela responde 503 —
# ao contrario das demais rotas, que ficam abertas quando OS_API_KEY esta vazia.

# Monitor da tarefa agendada "Integração WBC" (Task Scheduler do Windows)
# O script monitor_wbc_task.ps1 (agendado a cada 10 min via install_monitor_task.ps1)
# grava o estado; a API só LÊ o arquivo e o expõe em /status (?checks=tarefa).
# WBC_TASK_NAME=Integração WBC          # nome exato da tarefa monitorada no Task Scheduler
# WBC_TASK_STATE_FILE=state/wbc_task_state.json  # relativo à raiz do projeto (ou caminho absoluto)
# WBC_TASK_STALE_MIN=25                 # estado mais velho que isso = monitor possivelmente parado

# Windows Update / reboot pendente (windows_update.py — check `windows_update` do /status).
# A busca de updates custa ~3,1s nesta maquina (30s a frio) e roda numa THREAD daemon no
# start da API; o /status so le o cache. Nao ha agendador: o boot diario (~06:12) e o
# agendamento. Os defaults sao os medidos — so mexa com motivo.
# WU_ENABLED=true                       # false desliga a coleta (o reboot pendente continua)
# WU_DELAY_START_S=300                  # espera da thread apos o start da API
# WU_VARREDURA_MAX_D=7                  # varredura mais velha que isso => "pendentes" vira null
#                                       # (NUNCA 0: com o agente sem varrer a busca responde 0 e mente)
# WU_COLETA_TIMEOUT_S=120               # teto do powershell da coleta

# Configuração SQL Server (opcional — enriquece SITCOD/ORCALTDTH)
SQL_HOST=seu_host_sql
SQL_PORT=1433
SQL_USER=seu_usuario_sql
SQL_PASSWORD=sua_senha_sql
SQL_DATABASE=WBCCAD
# SQL_ENRICHMENT_VIEW=WBCCAD.dbo.INTEGRACAO_ORCSIT   # SQL Server view for SITCOD/ORCALTDTH
# SITCOD_DOMAIN_TABLE=situacoes_orcamento            # Supabase FK domain for SITCOD validation
# SQL_DRIVER=ODBC Driver 18 for SQL Server   # optional: force a specific ODBC driver
# Aliases: SQLSERVER_HOST, SQLSERVER_PORT, etc. (same as SQL_*)
# Obs.: o SQL Server segue em uso só pelo pipeline de OPORTUNIDADES; a árvore de
# produto WBC agora vem dentro da view HANA VW_OS_INTEGRACAO (não há mais sub-sync
# de árvore WBC via SQL Server nem de views de impressão).

# Scheduler (scripts/scheduled_execution.py)
# INTERVALO_MINUTOS=30
# JANELA_HORAS=7-18
# EXECUTION_MODE=snapshot          # snapshot | insert (upsert removido)
# Dias: seg-sex automático + feriados nacionais BR (feriados_br.py, até 2030)

# =============================================================================
# Integração WBC → SAP (pacote wbcpython/: worker `python -m wbcpython worker` e
# painel `python -m wbcpython dashboard`). Um só .env: estas variáveis convivem com
# as de cima sem colidir (SL_* é o Service Layer do WBC; OP_SL_* é o de Ordem de
# Produção; HANA_* é o hdbcli do WBC; SAP_* é o hdbcli das oportunidades).
# =============================================================================
# Ambiente lógico: "homolog" ou "prod". A .11 roda "prod".
WBC_ENVIRONMENT=homolog
# Trava: true bloqueia QUALQUER escrita na company de produção (ProductionWriteBlocked).
# Na .11 está false DE PROPÓSITO (decisão de 02/09/2026, docs/wbc/DECISOES.md).
WBC_BLOCK_PRODUCTION_WRITES=true
WBC_PRODUCTION_COMPANY_DB=SBOALTAMIRAPROD

# Service Layer que RECEBE a escrita (cotação, pedido, oportunidade, OrcDetalhe)
SL_BASE_URL=https://sapbusinessonehana-vm:50000/b1s/v1
SL_COMPANY_DB=SBOALTAMIRAHOMOLOG
SL_USERNAME=
SL_PASSWORD=
SL_VERIFY_SSL=false                 # cert autoassinado; true (ou SL_CA_BUNDLE) quando houver cert
# SL_CA_BUNDLE=
SL_TIMEOUT_SECONDS=60

# SQL Server do WBC (WBCCAD) — SOMENTE LEITURA, sem chave que desligue (wbcpython.safety)
WBC_SQL_HOST=
WBC_SQL_PORT=1433
WBC_SQL_DATABASE=WBCCAD
WBC_SQL_USERNAME=
WBC_SQL_PASSWORD=

# HANA via hdbcli para as views de relatório do WBC. HANA_SCHEMA = MESMA company do
# SL_COMPANY_DB (a leitura das oportunidades usa SL_COMPANY_DB, de propósito).
HANA_HOST=sapbusinessonehana-vm
HANA_PORT=30015
HANA_USERNAME=
HANA_PASSWORD=
HANA_SCHEMA=SBOALTAMIRAHOMOLOG

# Banco de acompanhamento (alimenta o painel; lido pelo /status?checks=wbc).
# Relativo à raiz do projeto (cwd dos run_*.bat). state/ é runtime e está no .gitignore.
TRACKING_DB_URL=sqlite:///./state/wbc_tracking.db

# Worker: intervalo entre ciclos, expediente e dias (ISO: 1=segunda … 7=domingo).
# Valores de PRODUÇÃO em 08/09/2026: 180 s, 07:00–20:00, 1,2,3,4,5.
WORKER_INTERVAL_SECONDS=300
WORKER_HORARIO_INICIO=06:30
WORKER_HORARIO_FIM=19:00
WORKER_DIAS_DE_TRABALHO=1,2,3,4,5
MESES_DE_JANELA=6                   # janela de OOPR.OpenDate; define o raio de impacto
MESES_DE_JANELA_DIRIGIDA=12         # janela do `ciclo --orcamento`
LIMITE_DE_ESCRITA_POR_CICLO=200     # teto de escritas por ciclo
FATOR_PESO_EMBARQUE=1.10            # folga de embalagem sobre o peso da árvore (regra de negócio)
LOG_LEVEL=INFO
LOG_FILE=logs/wbcpython.log         # mesmo texto da tela; a aba "Log" do painel lê daqui

# Painel (FastAPI). Entra com a MESMA chave da API 8077 (OS_API_KEY, acima): sem
# OS_API_KEY o painel fica aberto, como a API. PAINEL_SENHA libera os comandos de
# ESCRITA da aba "Executar" (vazia = desabilitados; em produção ficam desabilitados
# de qualquer forma).
PAINEL_HOST=0.0.0.0
PAINEL_PORTA=8079
PAINEL_SENHA=
# Links cruzados entre as duas páginas. Vazios = mesmo host da requisição, nas portas
# OS_API_PORT (8077) e PAINEL_PORTA (8079).
# SIS_PAINEL_URL=http://192.168.7.11:8077/
# WBC_PAINEL_URL=http://192.168.7.11:8079/
